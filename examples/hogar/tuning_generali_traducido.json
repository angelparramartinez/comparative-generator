{
    "commercialDiscountNumber": {
        "allowSavedTuning": true,
        "component": "number",
        "label": "Descuento comercial %",
        "max": 100,
        "min": -100,
        "required": false,
        "section": "section.discounts",
        "step": 1,
        "suffix": "/tuning?.commercialDiscountNumber < 0 ? { 'text': 'Recargo', 'style': 'warning' } : {}/",
        "type": "number",
        "value": 0
    },
    "jewelryInQuote": {
        "component": "radio",
        "label": "Joyas en caja fuerte con valor unitario igual o superior a 6.000€",
        "options": [
            {
                "items": [
                    {
                        "label": "si",
                        "value": "S"
                    },
                    {
                        "label": "no",
                        "value": "N"
                    }
                ]
            }
        ],
        "required": "/#this?.stage == 'preissuance' && insurance.risk.jewelsInSafeBoxLimit > 5999/",
        "section": "section.additionalData",
        "type": "string",
        "value": null,
        "visible": "/insurance.risk.jewelsInSafeBoxLimit > 5999/"
    },
    "jewelryInQuoteAmmount": {
        "component": "number",
        "label": "Suma de los importes de las Joyas en caja fuerte con valor unitario igual o superior a 6.000€",
        "max": "/insurance.risk.jewelsInSafeBoxLimit/",
        "min": "/tuning?.jewelryInQuote == 'S' ? 6000 : 0/",
        "required": "/tuning?.jewelryInQuote == 'S'/",
        "section": "section.additionalData",
        "step": 1,
        "type": "number",
        "value": 0,
        "visible": "/tuning?.jewelryInQuote == 'S'/"
    },
    "jewelryQuote": {
        "component": "radio",
        "label": "Joyas fuera de caja fuerte con valor unitario igual o superior a 6.000€",
        "options": [
            {
                "items": [
                    {
                        "label": "si",
                        "value": "S"
                    },
                    {
                        "label": "no",
                        "value": "N"
                    }
                ]
            }
        ],
        "required": "/#this?.stage == 'preissuance' && insurance.risk.jewelsOutSafeBoxLimit > 5999/",
        "section": "section.additionalData",
        "type": "string",
        "value": null,
        "visible": "/insurance.risk.jewelsOutSafeBoxLimit > 5999/"
    },
    "jewelryQuoteAmmount": {
        "component": "number",
        "label": "Suma de los importes de las Joyas fuera de caja fuerte con valor unitario igual o superior a 6.000€",
        "max": "/insurance.risk.jewelsOutSafeBoxLimit/",
        "min": "/tuning?.jewelryQuote == 'S' ? 6000 : 0/",
