        "section": "section.additionalData",
        "step": 1,
        "type": "number",
        "value": 0,
        "visible": "/tuning?.jewelryQuote == 'S'/"
    },
    "qfrqu1": {
        "allowSavedTuning": true,
        "component": "select",
        "label": "Franquicia general",
        "options": [
            {
                "items": [
                    {
                        "label": "Sin franquicia",
                        "value": "1"
                    },
                    {
                        "label": "200 euros",
                        "value": "2"
                    },
                    {
                        "label": "400 euros",
                        "value": "3"
                    },
                    {
                        "label": "600 euros",
                        "value": "4"
                    }
                ]
            }
        ],
        "required": false,
        "section": "section.additionalData",
        "type": "string",
        "value": "1"
    },
    "qrcand": {
        "allowSavedTuning": true,
        "component": "radio",
        "label": "Responsabilidad civil por propiedad y tenencia de perros",
        "required": true,
        "section": "section.covers",
        "type": "boolean",
        "value": "/#this?.stage == 'edit' ? false : ((insurance.risk.use=='Owner' || insurance.risk.use=='Tenant') && insurance.risk.occupancy=='MainResidence') && insurance.risk.dangerousDogsNumber>0?true:false/",
        "visible": "/(insurance.risk.use=='Owner' || insurance.risk.use=='Tenant') && insurance.risk.occupancy=='MainResidence'/"
    },
    "qrjard": {
        "allowSavedTuning": true,
        "component": "radio",
        "label": "Reconstrucción de jardines",
        "required": false,
        "section": "section.covers",
        "type": "boolean",
        "value": "/tuning?.zrjard == true ? false : tuning?.qrjard/",
        "visible": true
    },
    "wdomi": {
        "component": "number",
        "help": "Estos metros se descontarán de la superficie total de la vivienda introducida en el campo “Superficie total construida”",
        "label": "Metros construidos de los anexos",
        "max": 9999,
        "min": 0,
        "required": true,
        "section": "section.additionalData",
        "step": 1,
        "type": "number",
        "value": 0,
        "visible": true
    },
    "wpobl": {
        "component": "number",
        "label": "Número máximo de perros (incluye peligrosos y no peligrosos)",
        "max": 5,
        "min": "/tuning?.qrcand ? 1 : 0/",
        "required": "/tuning?.qrcand/",
        "section": "section.covers",
        "step": 1,
        "type": "number",
        "value": "/tuning?.qrcand ? insurance.risk.dangerousDogsNumber : null/",
        "visible": "/tuning?.qrcand/"
    },
